{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Minimum Phase 1 permissions for local Command Center persistence.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "stronghold:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-exists",
    "fs:allow-remove",
    "fs:scope-appconfig",
    "fs:scope-applocaldata",
    "fs:scope-desktop-recursive",
    "fs:scope-document-recursive",
    "fs:scope-download-recursive"
  ]
}
